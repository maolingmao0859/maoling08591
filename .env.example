# Full CMS server: provide a stable randomly generated signing secret locally.
# Do not put secrets in GitHub. Generate using: openssl rand -hex 32
CMS_ENABLED=true
PAYLOAD_SECRET=
DATABASE_URI=file:/absolute/persistent/path/content.db
CMS_STORAGE_DIR=/absolute/persistent/path/uploads
CMS_SERVER_URL=https://your-cms-domain.example
# Only true for development; production uses reviewed migrations.
CMS_ALLOW_SCHEMA_PUSH=false
# Vercel/frontend-only mode instead: CMS_ENABLED=false and set this to the CMS origin.
# CMS_REMOTE_URL=https://your-cms-domain.example
